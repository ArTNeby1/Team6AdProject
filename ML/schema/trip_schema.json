{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TripExtraction",
  "description": "AI 从旅游攻略文本中抽取出的结构化行程数据。字段设计见 field_notes.md",
  "type": "object",
  "required": ["destination", "places"],
  "additionalProperties": false,
  "properties": {
    "destination": {
      "type": "string",
      "description": "整趟行程的目的地城市/地区，例如 'Singapore'"
    },
    "dates": {
      "type": "array",
      "default": [],
      "description": "文本中明确出现的日历日期，格式 YYYY-MM-DD。文本只写 Day 1/Day 2 没给真实日期时，留空数组",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "description": "文本中提到的所有地点",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "地点名称。上限对齐后端 draft_place.name VARCHAR(255)，防止模型把整句话当地点名"
          },
          "type": {
            "type": "string",
            "enum": ["attraction", "restaurant", "hotel", "market", "other"],
            "description": "地点类型"
          },
          "coords": {
            "type": ["object", "null"],
            "default": null,
            "description": "经纬度。文本里基本不会出现坐标，禁止模型编造，缺失填 null，真实坐标由下游地理编码步骤补全",
            "required": ["lat", "lng"],
            "additionalProperties": false,
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          },
          "activities": {
            "type": "array",
            "default": [],
            "description": "在这个地点做的事情",
            "items": { "type": "string", "maxLength": 255 }
          }
        }
      }
    }
  }
}

# 本地开发配置模板。复制成同目录下的 .env（那个文件已经在 .gitignore 里，
# 不会被提交），把值换成你自己本机的实际配置。
#
#   cp backend/.env.example backend/.env
#
# 然后用 backend/run-local.sh 启动后端，会自动读取 .env 里的值——
# 不用每次手动 export，也不用把自己的密码写进会被提交的配置文件里。

# 本机 MySQL root 密码（跟 application-dev.yml 里 spring.datasource.password 对应）
DB_PASSWORD=your_local_mysql_root_password
